{
  "name": "proteus",
  "productName": "海神Proteus",
  "version": "0.1.0",
  "description": "Roleplay chat app for large language models (desktop version with built-in Chromium)",
  "main": "electron/main.js",
  "author": "IonComan813",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/IonComan813/ProjectProteus",
  "repository": {
    "type": "git",
    "url": "https://github.com/IonComan813/ProjectProteus.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:mac": "electron-builder --mac",
    "android:sync": "node scripts/build-www.js && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3",
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.ioncoman813.proteus",
    "productName": "海神Proteus",
    "copyright": "Copyright © 2026 IonComan813 · GPL-3.0",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "electron/**",
      "build/icon.png",
      "LICENSE"
    ],
    "artifactName": "Proteus-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "海神Proteus",
      "license": "LICENSE",
      "artifactName": "Proteus-Setup-${version}-win-x64.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.role-playing-games",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "executableName": "Proteus"
  }
}
